# ============================================================
#  ClipGenerator — Environment Configuration Template
#  Copy this file to .env and fill in your credentials:
#      cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# 1. Groq API Key (Free at https://console.groq.com)
# ------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here

# ------------------------------------------------------------
# 2. LLM Model Selection
# ------------------------------------------------------------
# Options available on Groq:
#   - openai/gpt-oss-120b      (Large-scale reasoning model)
#   - llama-3.3-70b-versatile  (Meta flagship 70B model)
#   - llama-3.1-8b-instant     (Fastest lightweight model)
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------
# 3. Speech-to-Text Model Selection
# ------------------------------------------------------------
# Groq Whisper Cloud (free & instant):
#   - whisper-large-v3        (Recommended: highest accuracy)
#   - whisper-large-v3-turbo  (Faster inference)
GROQ_WHISPER_MODEL=whisper-large-v3

# ------------------------------------------------------------
# 4. Server Configuration
# ------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------
# 5. Storage Directories
# ------------------------------------------------------------
UPLOADS_DIR=uploads
OUTPUTS_DIR=outputs

# ------------------------------------------------------------
# 6. Database (Async SQLite)
# ------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./clipgenerator.db
DB_ECHO=False

# ------------------------------------------------------------
# 7. Background Task Queue (Optional)
# ------------------------------------------------------------
# Set USE_CELERY=True only if you have Redis and Celery installed and running.
# By default, False uses the built-in Python background thread pool.
USE_CELERY=False
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------------------------
# 8. Local Whisper Fallback Settings
# ------------------------------------------------------------
# Model sizes: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ------------------------------------------------------------
# 9. Custom FFmpeg Path (Optional)
# ------------------------------------------------------------
# Leave commented out if ffmpeg is in your system PATH or imageio-ffmpeg is used.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
